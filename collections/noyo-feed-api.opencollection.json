{
  "opencollection": "1.0.0",
  "info": {
    "name": "Noyo Carrier Carrier Mapped Field Feed API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Feed",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of Feed Runs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/ui/v1/feeds/:id/runs",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the feed"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "The max size of each page of results"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The integer offset at which to start the page. Possible values are 0 to total_records - 1"
              }
            ]
          },
          "docs": "Returns a list of feed runs"
        }
      ]
    }
  ],
  "bundled": true
}